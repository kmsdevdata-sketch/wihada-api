{
  "family": "p3-api-dev",
  "taskRoleArn": "arn:aws:iam::851563824752:role/p3-role-ecs-task-dev",
  "executionRoleArn": "arn:aws:iam::851563824752:role/p3-role-ecs-task-execution-dev",
  "networkMode": "bridge",
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "p3-api",
      "image": "851563824752.dkr.ecr.ap-northeast-2.amazonaws.com/p3-ecr-api-dev:placeholder",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "ap-northeast-2"
        },
        {
          "name": "POSTGRES_HOST",
          "value": "p3-rds-dev.cv04kyy4s6bp.ap-northeast-2.rds.amazonaws.com"
        },
        {
          "name": "POSTGRES_PORT",
          "value": "5432"
        },
        {
          "name": "POSTGRES_DB",
          "value": "p3"
        },
        {
          "name": "POSTGRES_USER",
          "value": "p3admin"
        },
        {
          "name": "REDIS_HOST",
          "value": "p3-valkey-dev-001.p3-valkey-dev.kfa1ac.apn2.cache.amazonaws.com"
        },
        {
          "name": "REDIS_PORT",
          "value": "6379"
        },
        {
          "name": "REDIS_SSL",
          "value": "true"
        },
        {
          "name": "COGNITO_ISSUER_URI",
          "value": "https://cognito-idp.ap-northeast-2.amazonaws.com/ap-northeast-2_h04HbdnY8"
        },
        {
          "name": "P3_CORS_ALLOWED_ORIGINS",
          "value": "https://wihada.com,https://www.wihada.com,https://seller.wihada.com,https://admin.wihada.com,http://localhost:3000"
        },
        {
          "name": "P3_WEBSOCKET_ALLOWED_ORIGINS",
          "value": "https://wihada.com,https://www.wihada.com,https://seller.wihada.com,https://admin.wihada.com,http://localhost:3000"
        },
        {
          "name": "P3_WEB_BASE_URL",
          "value": "https://wihada.com"
        },
        {
          "name": "P3_DELIVERY_BASE_URL",
          "value": "https://d4omkcg1gc1ie.cloudfront.net"
        },
        {
          "name": "P3_ACCOUNT_ENCRYPTION_KEY_VERSION",
          "value": "v1"
        },
        {
          "name": "P3_KFTC_AUTH_BASE_URL",
          "value": "https://openapi.openbanking.or.kr"
        },
        {
          "name": "P3_KFTC_API_BASE_URL",
          "value": "https://openapi.openbanking.or.kr"
        },
        {
          "name": "P3_KFTC_VERIFICATION_ENABLED",
          "value": "false"
        },
        {
          "name": "P3_MAIL_ENABLED",
          "value": "true"
        },
        {
          "name": "P3_SELLER_INQUIRIES_URL",
          "value": "https://seller.wihada.com/seller/home?tab=waiting"
        }
      ],
      "secrets": [
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:851563824752:parameter/p3/dev/api/POSTGRES_PASSWORD"
        },
        {
          "name": "P3_INTERNAL_AUTH_TOKEN",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:851563824752:parameter/p3/dev/api/P3_INTERNAL_AUTH_TOKEN"
        },
        {
          "name": "P3_JUSO_SEARCH_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:851563824752:parameter/p3/dev/api/P3_JUSO_SEARCH_API_KEY"
        },
        {
          "name": "P3_POINT3_CLIENT_ID",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:851563824752:parameter/p3/dev/api/P3_POINT3_CLIENT_ID"
        },
        {
          "name": "P3_POINT3_API_TOKEN",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:851563824752:parameter/p3/dev/api/P3_POINT3_API_TOKEN"
        },
        {
          "name": "P3_ACCOUNT_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:851563824752:parameter/p3/dev/api/P3_ACCOUNT_ENCRYPTION_KEY"
        },
        {
          "name": "P3_KFTC_CLIENT_ID",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:851563824752:parameter/p3/dev/api/P3_KFTC_CLIENT_ID"
        },
        {
          "name": "P3_KFTC_CLIENT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:851563824752:parameter/p3/dev/api/P3_KFTC_CLIENT_SECRET"
        },
        {
          "name": "P3_KFTC_USE_ORG_CODE",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:851563824752:parameter/p3/dev/api/P3_KFTC_USE_ORG_CODE"
        },
        {
          "name": "GMAIL_USERNAME",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:851563824752:parameter/p3/dev/api/GMAIL_USERNAME"
        },
        {
          "name": "GMAIL_APP_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:851563824752:parameter/p3/dev/api/GMAIL_APP_PASSWORD"
        },
        {
          "name": "MAIL_FROM",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:851563824752:parameter/p3/dev/api/MAIL_FROM"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/p3-api-dev",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "p3-api"
        }
      }
    }
  ]
}
